# Copy this file to .env and fill in your values.
# Never commit .env to git.

DB_HOST=localhost
DB_PORT=3306
DB_USER=glasslogic_user
DB_PASSWORD=your_password_here
DB_NAME=glasslogic

PORT=4000
CLIENT_URL=http://localhost:5173

# RBAC auth (see middleware/authenticate.js, routes/auth.js)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Optional: customer portal token lifetime (see middleware/authenticateCustomer.js,
# routes/customerAuth.js). Defaults to 24h if unset.
# CUSTOMER_JWT_EXPIRES_IN=24h
